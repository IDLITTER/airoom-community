# 复制为 .env。此文件只含占位符，不包含任何有效凭据。
AIROOM_LOGIN_CODE=replace-with-your-own-long-random-login-code
AIROOM_HOST=127.0.0.1
AIROOM_PORT=18888
AIROOM_TIMEZONE=Asia/Shanghai
# AIROOM_DATA=./data

# OpenAI 兼容接口根地址，通常以 /v1 结尾，不含 /chat/completions。
# 共用路由：所有角色可以共用一个兼容服务，每位角色覆盖自己的模型。
AIROOM_BASE_URL=
AIROOM_API_KEY=
AIROOM_MODEL=

AIROOM_GPT_BASE_URL=
AIROOM_GPT_API_KEY=
AIROOM_GPT_MODEL=
AIROOM_GEMINI_BASE_URL=
AIROOM_GEMINI_API_KEY=
AIROOM_GEMINI_MODEL=
AIROOM_DEEPSEEK_BASE_URL=
AIROOM_DEEPSEEK_API_KEY=
AIROOM_DEEPSEEK_MODEL=
AIROOM_CLAUDE_BASE_URL=
AIROOM_CLAUDE_API_KEY=
AIROOM_CLAUDE_MODEL=
# 全部留空时总结助理共用 GPT 配置；填写后独立配置。
AIROOM_SUMMARY_BASE_URL=
AIROOM_SUMMARY_API_KEY=
AIROOM_SUMMARY_MODEL=
